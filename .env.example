# Environment Variables — DO NOT commit real values
# Copy this file to .env and fill in your values

# ⚠️ REQUIRED: Your team's unique salt from the competition slip
DAY1_SALT=your-day1-salt-here

# JWT signing secret (generate a strong random string)
JWT_SECRET=change-me-to-a-strong-random-secret

# Database (auto-configured by docker-compose)
DATABASE_URL=postgresql+asyncpg://sports:sports123@db:5432/sportsdb

# Redis (auto-configured by docker-compose)
REDIS_URL=redis://redis:6379/0

# MinIO object storage (auto-configured by docker-compose)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=receipts
